# URL PostgreSQL dari penyedia hosting. Untuk lokal, sesuaikan pengguna dan sandi.
DATABASE_URL=postgresql://postgres:password@localhost:5432/inventaris_tonasa

# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Dibutuhkan sekali untuk membuat admin pertama pada database baru.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aplikasi dan API menggunakan domain yang sama. Isi CORS_ORIGIN bila klien berbeda domain.
CORS_ORIGIN=
ALLOW_PUBLIC_REGISTRATION=false
